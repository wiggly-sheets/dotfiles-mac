# =========================================================
# SPACE LAYOUTS & NAVIGATION
# =========================================================
# switch current space layout
alt - s : /opt/homebrew/bin/yabai -m space --layout stack
alt - b : /opt/homebrew/bin/yabai -m space --layout bsp
alt - u : /opt/homebrew/bin/yabai -m space --layout float
alt - i : /opt/homebrew/bin/yabai -m space --layout scroll
alt - c : /opt/homebrew/bin/yabai -m space --layout accordion
ctrl + alt - space : /opt/homebrew/bin/yabai -m space --layout $(/opt/homebrew/bin/yabai -m query --spaces --space | /opt/homebrew/bin/jq -r '.type' | awk '{print ($1=="bsp"?"stack":($1=="stack"?"float":"bsp"))}')

# move space forward or backward
alt - o : sh -c '/opt/homebrew/bin/yabai -m space --move prev || /opt/homebrew/bin/yabai -m space --move last;  /opt/homebrew/bin/sketchybar --trigger space_change; /opt/homebrew/bin/sketchybar --trigger space_windows_change'
