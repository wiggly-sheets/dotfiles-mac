# =========================================================
# SYSTEM & EXCEPTIONS
# =========================================================
# Use custom shell (skips interactive shell overhead)
.shell "/bin/dash"

# Blacklist applications (skip hotkey processing)
.blacklist [
    "VMware Fusion"
]

# Define process groups for reuse
.define terminal_apps ["wezterm", "terminal", "iterm"]
.define native_apps ["safari"]
.define browser_apps ["safari", "helium", "zen"]

# Linux-style word navigation and deletion
ctrl - backspace [
    @native_apps ~         # Terminal apps handle natively
    *            | alt - backspace  # Other apps: delete
]

ctrl - left [
    @native_apps ~         # Terminal apps handle natively
    *            | alt - left       # Other apps: move word left
]

ctrl - right [
    @native_apps ~         # Terminal apps handle natively
    *            | alt - right      # Other apps: move word right
]

# Home/End key behavior (with shift for selection)
home [
    @native_apps ~         # Terminal apps handle natively
    *            | cmd - left       # Other apps: line start
]

shift - home [
    @native_apps ~         # Terminal apps handle natively
    *            | cmd - right  # Other apps: select to line start
]

# Ctrl+Home/End for document navigation
ctrl - home [
    @native_apps ~         # Terminal apps handle natively
    *            | cmd - up         # Other apps: document start
]

ctrl - end [
    @native_apps ~         # Terminal apps handle natively
    *            | cmd - down       # Other apps: document end
]


# =========================================================
# WINDOW FOCUS, WARP, SWAP & RESIZE
# =========================================================
# change window focus
alt - j : /opt/homebrew/bin/yabai -m window --focus south || /opt/homebrew/bin/yabai -m display --focus south
alt - k : /opt/homebrew/bin/yabai -m window --focus north || /opt/homebrew/bin/yabai -m display --focus north
alt - h : /opt/homebrew/bin/yabai -m window --focus west || /opt/homebrew/bin/yabai -m display --focus west
alt - l : /opt/homebrew/bin/yabai -m window --focus east || /opt/homebrew/bin/yabai -m display --focus east
cmd + shift - space : /opt/homebrew/bin/yabai -m window --focus next || /opt/homebrew/bin/yabai -m window --focus first
alt + shift - space : /opt/homebrew/bin/yabai -m window --focus prev || /opt/homebrew/bin/yabai -m window --focus last

# Resize windows
shift + cmd - h : /opt/homebrew/bin/yabai -m window --resize right:-100:0 2> /dev/null || /opt/homebrew/bin/yabai -m window --resize left:-50:0 2> /dev/null
shift + cmd - j : /opt/homebrew/bin/yabai -m window --resize bottom:0:100 2> /dev/null || /opt/homebrew/bin/yabai -m window --resize top:0:50 2> /dev/null
shift + cmd - k : /opt/homebrew/bin/yabai -m window --resize bottom:0:-100 2> /dev/null || /opt/homebrew/bin/yabai -m window --resize top:0:-50 2> /dev/null
shift + cmd - l : /opt/homebrew/bin/yabai -m window --resize right:100:0 2> /dev/null || /opt/homebrew/bin/yabai -m window --resize left:50:0 2> /dev/null

# window insertion points for splits
cmd + ctrl - l : /opt/homebrew/bin/yabai -m window --insert east
cmd + ctrl - h : /opt/homebrew/bin/yabai -m window --insert west
cmd + ctrl - j : /opt/homebrew/bin/yabai -m window --insert south
cmd + ctrl - k : /opt/homebrew/bin/yabai -m window --insert north

# resize & move floating windows
cmd + shift - left : /opt/homebrew/bin/yabai -m window --toggle float; /opt/homebrew/bin/yabai -m window --grid 1:2:0:0:1:1
cmd + shift - right : /opt/homebrew/bin/yabai -m window --toggle float; /opt/homebrew/bin/yabai -m window --grid 1:2:1:0:1:1
cmd + shift - up : /opt/homebrew/bin/yabai -m window --toggle float; /opt/homebrew/bin/yabai -m window --grid 2:1:0:0:1:1
cmd + shift - down : /opt/homebrew/bin/yabai -m window --toggle float; /opt/homebrew/bin/yabai -m window --grid 2:1:0:1:1:1
alt + shift - up : /opt/homebrew/bin/yabai -m window --toggle float; /opt/homebrew/bin/yabai -m window --grid 1:1:0:0:1:1
alt + shift - down : /opt/homebrew/bin/yabai -m window --toggle float; /opt/homebrew/bin/yabai -m window --grid 5:5:1:1:3:3
alt + shift - left : /opt/homebrew/bin/yabai -m window --toggle float; /opt/homebrew/bin/yabai -m window --grid 1:3:0:0:1:1
alt + shift - right : /opt/homebrew/bin/yabai -m window --toggle float; /opt/homebrew/bin/yabai -m window --grid 1:3:2:0:1:1

# raise window to top of layer
alt - up : /opt/homebrew/bin/yabai -m window --raise

# lower window to bottom of layer
alt - down : /opt/homebrew/bin/yabai -m window --lower

# toggle window float
shift + alt - u : /opt/homebrew/bin/yabai -m window --toggle float --grid 5:5:1:1:3:3; /opt/homebrew/bin/yabai -m window --sub-layer below

# make window float on top of all other windows
shift + alt - o : /opt/homebrew/bin/yabai -m window --toggle float --grid 5:5:1:1:3:3; /opt/homebrew/bin/yabai -m window --sub-layer above

# toggle window appear on all spaces
shift + alt - s : /opt/homebrew/bin/yabai -m window --toggle sticky

# zoom window to take up whole space
shift + alt - m : /opt/homebrew/bin/yabai -m window --toggle zoom-fullscreen

# move window to native full-screen 
shift + alt - z : /opt/homebrew/bin/yabai -m window --toggle native-fullscreen

# zoom window to take up size of parent node
shift + alt - i : /opt/homebrew/bin/yabai -m window --toggle zoom-parent

# make window pip & pin to all spaces
