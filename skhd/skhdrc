ctrl + cmd - 3 : sh -c '/opt/homebrew/bin/yabai -m space --display 3 --focus; /opt/homebrew/bin/sketchybar --trigger space_change; /opt/homebrew/bin/sketchybar --trigger space_windows_change'

# notes scratchpad
meh - s : /opt/homebrew/bin/yabai -m window --toggle scratchpad || open -a Stickies

# show all scratchpad windows if inaccessible due to /opt/homebrew/bin/yabai restart or crash
meh - d : /opt/homebrew/bin/yabai -m window --scratchpad recover


alt - a : /opt/homebrew/bin/yabai -m space --create

# make new space at last index & send window to it
# (NOTE: Exact duplicate of this removed from bottom of file)
shift + alt - a : ~/dotfiles/yabai/scripts/new_space_window.sh

# make new space at last index, send window to it, & follow focus
shift + cmd - a : ~/dotfiles/yabai/scripts/new_space_window_focus.sh

# make new space 1 index after current space
ctrl - a : ~/dotfiles/yabai/scripts/new_space_after.sh

# make new space 1 index after current space & follow focus
ctrl - t : ~/dotfiles/yabai/scripts/new_space_after_follow.sh

ctrl - b : ~/dotfiles/yabai/scripts/new_space_before.sh

ctrl - v : ~/dotfiles/yabai/scripts/new_space_before_focus.sh

ctrl - q : ~/dotfiles/yabai/scripts/new_space_before_window.sh

ctrl - m : ~/dotfiles/yabai/scripts/new_space_before_window_focus.sh


# create space & follow focus
alt - t : ~/dotfiles/yabai/scripts/new_space_focus.sh

# destroy space, move destroyed space windows to previous space, & focus previous space
alt - w : ~/dotfiles/yabai/scripts/destroy_space.sh

# create space, move windows from current space to new space, and follow focus
cmd + shift - w : ~/dotfiles/yabai/scripts/move_space_windows_follow.sh

# create space and move windows from current space to new space
alt + shift - w : ~/dotfiles/yabai/scripts/move_space_windows.sh

