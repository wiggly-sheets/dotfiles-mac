#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    draw_borders: true,
    browser_column_widths: [20, 38, 42],
    background_color: "#1a1b26",
    modal_backdrop: true,
    text_color: "#c0caf5",
    header_background_color: "#1a1b26",
    modal_background_color: "#1a1b26",
    preview_label_style: (fg: "#bb9af7"),
    preview_metadata_group_style: (fg: "#7aa2f7"),
    song_table_album_separator: None,
    tab_bar: (
        enabled: true,
        active_style: (fg: "#1a1b26", bg: "#7aa2f7", modifiers: "Bold"),
        inactive_style: (fg: "#c0caf5", bg: "#1a1b26"),
    ),
    highlighted_item_style: (fg: "#1a1b26", bg: "#7aa2f7", modifiers: "Bold"),
    current_item_style: (fg: "#1a1b26", bg: "#bb9af7", modifiers: "Bold"),
    borders_style: (fg: "#7aa2f7", modifiers: "Bold"),
    highlight_border_style: (fg: "#7aa2f7"),
    symbols: (song: "󰝚 ", dir: " ", playlist: "󰲸 ", marker: "* ", ellipsis: "..."),
    progress_bar: (
        symbols: ["", "█", "", "█", "" ],
        track_style: (fg: "#292e42", bg: "#1a1b26"),
        elapsed_style: (fg: "#7aa2f7", bg: "#1a1b26"),
        thumb_style: (fg: "#7aa2f7", bg: "#1a1b26"),
    ),
    scrollbar: (
        symbols: ["┋", "█", "󰄿", "󰄼"],
        track_style: (fg: "#7aa2f7"),
        ends_style: (fg: "#7aa2f7"),
        thumb_style: (fg: "#7aa2f7"),
    ),
    song_table_format: [
        (
            prop: (kind: Transform(Replace(content: (kind: Sticker("like")), replacements: [
                (match: "2", replace: (kind: Text("★ "), style: (modifiers: "Bold"))),
            ])), default: (kind: Text(""))),
            width: "3",
            label: "",
            alignment: Left,
        ),
        (
            prop: (kind: Property(Artist),
                default: (kind: Text("Unknown Artist"))),
            width: "21%"
        ),
        (
            prop: (kind: Property(Album), style: (fg: "#7aa2f7"),
                default: (kind: Text("Unknown Album"), style: (fg: "#7aa2f7"))),
            width: "34%"
        ),
        (
            prop: (kind: Property(Title),
                default: (kind: Property(Filename))),
            width: "37%"
        ),
        (
            prop: (kind: Property(Duration),
                default: (kind: Text("-"))),
            width: "5%", alignment: Right
        ),
    ],
    layout: Split(
        direction: Vertical, panes: [
            (size: "3", pane: Pane(Tabs)),
            (size: "5", borders: "ALL", pane: Component("np_header")),
            (size: "100%", borders: "NONE", pane: Pane(TabContent)),
            (size: "3", borders: "TOP | BOTTOM", pane: Pane(ProgressBar)),
        ]),
    header: (rows: []),
    browser_song_format: [
        (kind: Group([
                    (kind: Property(Track)),
                    (kind: Text(" ")),
                ])),
        (kind: Group([
                    (kind: Property(Artist)),
                    (kind: Text(" - ")),
                    (kind: Property(Title)),
                ]), default: (kind: Property(Filename)))
    ],
    level_styles: (
        info:  (fg: "#9ece6a", bg: "#1a1b26"),
        warn:  (fg: "yellow"),
        error: (fg: "red"),
        debug: (fg: "light_green"),
        trace: (fg: "magenta"),
    ),
    components: {
        "queue_info": Pane(Property(
            content: [
                (kind: Text("󰲸 ")),
                (kind: Property(Status(QueueLength()))),
                (kind: Text(" tracks  ")),
                (kind: Property(Status(QueueTimeTotal()))),
            ], align: Left,
        )),
        "elapsed": Pane(Property(
            content: [
                (kind: Text("󰔚 ")),
                (kind: Property(Status(Elapsed))),
                (kind: Text(" / ")),
                (kind: Property(Status(Duration))),
                (kind: Text("  ")),
                (kind: Property(Status(Bitrate)), default: (kind: Text(""))),
                (kind: Text(" kbps")),
            ], align: Left,
        )),
        "title": Pane(Property(
            content: [
                (kind: Property(Status(StateV2(
                    playing_label: "󰏤 ",
                    paused_label: "󰐊 ",
                    stopped_label: "󰓛 ",
                ))), style: (modifiers: "Bold")),
                (kind: Text("  ")),
                (kind: Property(Song(Title)), style: (modifiers: "Bold"),
                    default: (kind: Property(Song(Filename)))),
            ], align: Center, scroll_speed: 1,
        )),
        "artist_and_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "#7aa2f7"),
                    default: (kind: Text("Unknown Artist"), style: (fg: "#7aa2f7"))),
                (kind: Text(" - ")),
                (kind: Property(Song(Album)), default: (kind: Text("Unknown Album"))),
            ], align: Center, scroll_speed: 1,
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "3", pane: Pane(Property(content: [
                    (kind: Text(" 󰕾"))
                ], align: Left))),
                (size: "100%", pane: Pane(Volume(kind: Slider(
                    symbols: (start: None, filled: "█", thumb: "█", track: "░", end: None),
                    filled_style: (fg: "#7aa2f7"),
                    thumb_style: (fg: "#7dcfff"),
                    track_style: (fg: "#3b4261"),
                )))),
                (size: "5", pane: Pane(Property(content: [
                    (kind: Property(Status(Volume)), style: (fg: "#c0caf5"))
                ], align: Right))),
                (size: "2", pane: Pane(Property(content: [
                    (kind: Text("%"), style: (fg: "#7aa2f7"))
                ], align: Left))),
                (size: "1", pane: Pane(Empty())),
            ],
        ),
        "states": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Empty())),
                (size: "100%", pane: Pane(Property(content: [
                    (kind: Property(Status(InputBuffer())), style: (fg: "#565f89"))
                ], align: Left))),
                (size: "13", pane: Pane(Property(content: [
                    (kind: Text(" "), style: (fg: "#7aa2f7", modifiers: "Bold")),
                    (kind: Property(Status(RepeatV2(
                        on_label: "󰑖  ",
                        off_label: "󰑗  ",
                        on_style: (fg: "#9ece6a", modifiers: "Bold"),
                        off_style: (fg: "#565f89", modifiers: "Bold"),
                    )))),
                    (kind: Property(Status(RandomV2(
                        on_label: "󰒝  ",
                        off_label: "󰒞  ",
                        on_style: (fg: "#9ece6a", modifiers: "Bold"),
                        off_style: (fg: "#565f89", modifiers: "Bold"),
                    )))),
                    (kind: Property(Status(ConsumeV2(
                        on_label: "󰮯 ",
                        off_label: "󰮯 ",
                        oneshot_label: "󰮯󰇊 ",
                        on_style: (fg: "#9ece6a", modifiers: "Bold"),
                        off_style: (fg: "#565f89", modifiers: "Bold"),
                        oneshot_style: (fg: "#e0af68", modifiers: "Bold"),
                    )))),
                    (kind: Property(Status(SingleV2(
                        on_label: "󰎤 ",
                        off_label: "󰎦 ",
                        oneshot_label: "󰇊 ",
                        off_oneshot_label: "󱅊 ",
                        on_style: (fg: "#9ece6a", modifiers: "Bold"),
                        off_style: (fg: "#565f89", modifiers: "Bold"),
                        oneshot_style: (fg: "#e0af68", modifiers: "Bold"),
                    )))),
                    (kind: Text(" "), style: (fg: "#7aa2f7", modifiers: "Bold")),
                ], align: Right))),
            ],
        ),
        "np_top": Split(
            direction: Horizontal,
            panes: [
                (size: "30%", pane: Component("elapsed")),
                (size: "37%", pane: Component("title")),
                (size: "33%", pane: Component("volume")),
            ],
        ),
        "np_bottom": Split(
            direction: Horizontal,
            panes: [
                (size: "30%", pane: Component("queue_info")),
                (size: "40%", pane: Component("artist_and_album")),
                (size: "30%", pane: Component("states")),
            ],
        ),
        "np_header": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("np_top")),
                (size: "1", pane: Component("np_bottom")),
                (size: "1", pane: Pane(Empty())),
            ],
        ),
    },
    cava: (
        bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
        bar_width: 1, bar_spacing: 1,
        bar_color: Single("#7aa2f7"),
    ),
)
