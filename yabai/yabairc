# scripting addition
echo "$(whoami) ALL=(root) NOPASSWD: sha256:$(shasum -a 256 /opt/homebrew/bin/yabai | cut -d " " -f 1) /opt/homebrew/bin/yabai --load-sa" | sudo -n tee /private/etc/sudoers.d/yabai
/opt/homebrew/bin/yabai -m signal --add event=dock_did_restart action="sudo /opt/homebrew/bin/yabai --load-sa"
sudo /opt/homebrew/bin/yabai --load-sa

# scratchpad setup
/opt/homebrew/bin/yabai -m rule --add app="^Stickies$" scratchpad=scratchpad grid=6:6:6:0:8:8

