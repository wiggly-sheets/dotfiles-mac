    "keyCode" : 49,
    "keyKind" : "keyCode",
    "modifiers" : [
      "ctrl"
    ]
  },
  "hudPosition" : {
    "kind" : "center"
  },
  "iconScale" : 0.5,
  "maxSpaces" : 8,
  "mode" : "auto",
  "multiMonitorHUDMode" : "unified",
  "pinnedHotkey" : {
    "keyKind" : "none",
    "modifiers" : [

    ]
  },
  "rows" : 2,
  "separateHUDVisibility" : "all",
  "showExtraWindows" : false,
  "showIconStrip" : true,
  "showMode" : "all",
  "showMultiAppIcons" : true,
  "showSpaceNames" : false,
  "showSpaceNumbers" : true,
  "socketHealthInterval" : 60,
  "spaceNames" : {

  },
  "theme" : "tokyo night",
  "uiScale" : 0.4,
  "unifiedHUDVisibility" : "active",
  "updateMode" : "notify",
  "useArrowKeys" : true,
  "useVimKeys" : true
