  "autoHideTimeout" : 2,
  "backgroundAlpha" : 0,
  "cellStyle" : "simple",
  "cols" : 4,
  "customHUDX" : 0.5,
  "customHUDY" : 0.5,
  "displayNavigationWrap" : "within",
  "focusSpaceOnWindowDrop" : true,
  "hideMenuBarIcon" : true,
