  "shell": "zsh",
  "disabled_providers": [],
  "lsp": true,
  //  "subagent_depth": 2,
  "share": "auto",
  "formatter": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000,
  },
  "instructions": ["./tools/philosophy.md"],
  "experimental": {},

  "mcp": {
    "xcode": {
      "type": "local",
      "command": [
        "node",
        "/Users/Zeb/Developer/mcp-servers/xcode-mcp-server/dist/index.js",
      ],
      "enabled": false,
      "environment": {
        "PROJECTS_BASE_DIR": "/Users/Zeb/Developer",
      },
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": false,
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": false,
    },
  },
  "permission": {
    "task": "deny",
    "context7_*": "deny",
    "exa_*": "deny",
    "gh_grep_*": "deny",
    "kagi_*": "deny",
    "webfetch": "deny",
    "worktree_*": "deny",
  },
}
