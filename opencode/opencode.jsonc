{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@tarquinen/opencode-dcp",
    "@mumme-it/opencode-caveman",
    "@dietrichgebert/ponytail"
  ],
  "agents": {
    "plan": {
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "creative": {
      "request": {
        "body": {
          "temperature": 0.8
        }
      }
    },
    "analyze": {
      "request": {
        "body": {
          "temperature": 0.1
        }
      }
    },
    "build": {
      "system": "You are a build orchestrator. You coordinate implementation through delegation - you do NOT implement directly. Your Role: Delegate implementation to `coder`. Delegate documentation to `scribe`. Delegate codebase analysis to `explore`. Delegate external research to `researcher`. Interpret results and decide next steps. Critical Constraint: You CANNOT edit files or run commands directly. For ALL implementation and verification, delegate to `coder`.",
      "request": {
        "body": {
          "temperature": 0.2,
          "reasoningEffort": "high",
          "textVerbosity": "low"
        }
      },
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "brainstorm": {
      "request": {
        "body": {
          "temperature": 0.7
        }
      }
    },
    "quick-thinker": {
      "description": "Fast reasoning with limited iterations",
      "steps": 5,
      "system": "You are a quick thinker. Solve problems with minimal steps."
    },
    "researcher": {
      "description": "Researches external sources and reads docs. No edits, no shell writes.",
      "mode": "subagent",
      "permissions": [
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "gh repo view*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh pr view*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh pr list*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh issue view*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh issue list*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh release view*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh release list*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh run view*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh run list*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh workflow list*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh search *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh api *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm view*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm info*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm show*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "pip show*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "pip index*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "cargo search*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "cargo info*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "man *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "tldr *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "dig *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "nslookup *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "whois *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "host *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "jq *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "head *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "tail *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "base64 *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "grep *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rg *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "wc *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "sort *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "uniq *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "cut *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "awk *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "tr *",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "context7_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "exa_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "gh_grep_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "kagi_*",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "scribe": {
      "description": "Writes and edits docs, README files, and prose. No shell commands.",
      "mode": "subagent",
      "permissions": [
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "coder": {
      "description": "Implements features and fixes: edits files, runs tests, verifies results.",
      "mode": "subagent",
      "permissions": [
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "context7_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "exa_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "gh_grep_*",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "reviewer": {
      "description": "Reviews diffs and code for defects. Reads and inspects only.",
      "mode": "subagent",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git diff*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git blame*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rg *",
          "effect": "allow"
        }
      ]
    },
    "explore": {
      "description": "Searches and reads the codebase to answer questions. No edits.",
      "mode": "subagent",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "ls *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "tree *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "pwd",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "cat *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "head *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "tail *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "wc *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "file *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "stat *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "grep *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rg *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "find *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git status*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git blame*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git branch*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git ls-files*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "uname*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "hostname",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "whoami",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "which *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "realpath *",
          "effect": "allow"
        }
      ]
    }
  },
  "permissions": [
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "context7_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "exa_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "gh_grep_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "kagi_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    }
  ],
